# Server-side (used in src/lib/supabase/server.ts, src/server/*)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Client-side (used in src/lib/supabase/client.ts) — must be prefixed VITE_
# to be exposed to the browser bundle. Same values as above.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
